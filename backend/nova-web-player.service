[Unit]
Description=NOVA Web Player (backend Node.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/nova-web-player/backend
ExecStart=/usr/bin/node /opt/nova-web-player/backend/dist/index.js
Restart=always
RestartSec=5
Environment="NODE_ENV=production"
Environment="PORT=3001"

[Install]
WantedBy=multi-user.target
